{
  "name": "@warpstate/playwright",
  "version": "0.0.0",
  "description": "Playwright helpers for warpstate: open your app straight into a captured scenario.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagokall/warpstate.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/tiagokall/warpstate#readme",
  "keywords": [
    "e2e",
    "testing",
    "snapshot",
    "state",
    "playwright",
    "react",
    "tanstack"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@warpstate/core": "workspace:^",
    "pixelmatch": "^7",
    "pngjs": "^7"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/pngjs": "^6.0.5",
    "zod": "^4.6.7"
  },
  "module": "./dist/index.js",
  "bin": {
    "warpstate-shots": "./dist/shots.js"
  }
}
