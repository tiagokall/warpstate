{
  "name": "@warpstate/core",
  "version": "0.0.0",
  "description": "Core of warpstate: snapshot format, validation, adapter registry and hydration lifecycle.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagokall/warpstate.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tiagokall/warpstate#readme",
  "keywords": [
    "e2e",
    "testing",
    "snapshot",
    "state",
    "playwright",
    "react",
    "tanstack"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./noop": {
      "import": {
        "types": "./dist/noop.d.ts",
        "default": "./dist/noop.js"
      },
      "require": {
        "types": "./dist/noop.d.cts",
        "default": "./dist/noop.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "zod": "^4.6.7",
    "jsdom": "^31.0.1"
  },
  "module": "./dist/index.js"
}
